# Godot 4+ specific ignores
.godot/
/android/

# Local character-pipeline caches (reproducible; do not commit)
tools/character_pipeline/source/mpfb_packs/
tools/character_pipeline/look_calib_01.blend
tools/character_pipeline/calib/

# Character Factory generated dumps must never enter git.
# Canonical outputs live under %LOCALAPPDATA%\DeadStreetCharacterFactory\
tools/character_factory/.local/

# Local Harold polish captures and working transfers
tools/battle_polish/results/
tools/battle_polish/transfer/
tools/battle_polish/*.log
tools/battle_polish/*.uid

# Local battle-finish capture and pose intermediates
tools/battle_finish/results/
tools/battle_finish/transfer/
tools/battle_finish/pose_svg/
tools/battle_finish/*.log
tools/battle_finish/*.uid

# Reproducible capture mirrors can link recursively back into the project.
tools/**/capture_project/

# Raw recording and transfer intermediates; finished MP4s and game media remain tracked.
tools/**/*.avi
tools/**/*.mkv
tools/**/*.b64
tools/**/transfer/
tools/**/transfer_*/
tools/**/*.log.mbtree
tools/repository_checkpoint_20260915/local/

# Frame-by-frame raw MovieWriter outputs.
tools/**/lossless/
tools/**/*_lossless/

# Generated standalone playtest candidate; rebuild from source and keep local.
tools/playtest_release_20260915/candidate/
