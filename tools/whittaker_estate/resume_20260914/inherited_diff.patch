+func _blit(dst: Image, src: Image, ox: int, oy: int) -> void:
+	if src == null:
+		return
+	for y in src.get_height():
+		for x in src.get_width():
+			dst.set_pixel(ox + x, oy + y, src.get_pixel(x, y))
