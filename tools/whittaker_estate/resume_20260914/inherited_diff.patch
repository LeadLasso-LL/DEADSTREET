+			var local: float = luma - blur_luma
+			if local > 0.045:
+				c = c.lerp(Color(clampf(c.r + 0.05, 0.0, 1.0), clampf(c.g + 0.05, 0.0, 1.0), clampf(c.b + 0.045, 0.0, 1.0), c.a), 0.35)
+			elif local < -0.045:
