+func transport_icon(symbol: String) -> Texture2D:
+	var shapes={
+		"pause":'<rect x="5" y="4" width="5" height="16"/><rect x="14" y="4" width="5" height="16"/>',
+		"play":'<path d="M6 4 L20 12 L6 20 Z"/>',
